---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'OpenMac — Free your Mac. It can do anything.',
	description = 'A curated, hands-on directory of open source apps for the Apple ecosystem — Mac, iPhone, iPad, Watch, TV and Vision. Tested by humans, metadata always fresh.',
} = Astro.props;

const nav = [
	{ path: '/apps', title: 'Apps' },
	{ path: '/reviews', title: 'Reviews' },
	{ path: '/about', title: 'About' },
];
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="alternate" type="application/rss+xml" title="OpenMac" href="/rss.xml" />
		<script is:inline>
			// Cactus theme strategy: dark by default, persisted in localStorage
			const theme = localStorage.getItem('theme') ?? 'dark';
			document.documentElement.dataset.theme = theme;
		</script>
	</head>
	<body
		class="bg-global-bg text-global-text mx-auto flex min-h-screen max-w-4xl flex-col px-4 pt-16 font-mono text-sm font-normal antialiased sm:px-8"
	>
		<header class="mb-10 flex flex-wrap items-center gap-x-8 gap-y-3">
			<a href="/" class="inline-flex items-baseline gap-2">
				<span class="text-accent-2 text-xl font-bold sm:text-2xl">OpenMac</span><span class="text-muted text-sm">.dev</span>
			</a>
			<nav aria-label="Main" class="flex flex-row divide-x">
				{
					nav.map((item) => (
						<a
							aria-current={Astro.url.pathname.startsWith(item.path) ? 'page' : false}
							class:list={[
								'cactus-link px-3 py-1.5 first:ps-0',
								Astro.url.pathname.startsWith(item.path) ? 'text-accent' : 'text-muted',
							]}
							href={item.path}
						>
							{item.title}
						</a>
					))
				}
			</nav>
			<button
				id="theme-toggle"
				aria-label="Toggle theme"
				class="text-muted ms-auto rounded border border-dashed border-zinc-500/40 px-2 py-1 text-xs hover:border-link/70 hover:text-global-text"
			>
				<span data-theme-icon>◐</span>
			</button>
			<div id="auth-box" class="flex items-center gap-2 text-xs"></div>
		</header>

		<main id="main" class="flex-1">
			<slot />
		</main>

		<footer class="mt-16 flex flex-col gap-2 border-t border-dashed border-zinc-500/40 py-8 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
			<p>Free your Mac. It can do anything.</p>
			<div class="flex gap-4">
				<a href="/rss.xml" class="cactus-link">rss</a>
				<a href="/about" class="cactus-link">about</a>
				<span>© 2026 openmac.dev</span>
			</div>
		</footer>

		<script>
			import { createAuthClient } from 'better-auth/client';

			const authClient = createAuthClient();
			const box = document.getElementById('auth-box');

			async function renderAuth() {
				if (!box) return;
				try {
					const { data } = await authClient.getSession();
					if (data?.user) {
						box.innerHTML = `
							<span class="text-muted hidden sm:inline">${data.user.email ?? data.user.name}</span>
							<button id="signout-btn" class="rounded border border-dashed border-zinc-500/40 px-2 py-1 hover:border-link/70 hover:text-global-text">sign out</button>
						`;
						document.getElementById('signout-btn')?.addEventListener('click', async () => {
							await authClient.signOut();
							await renderAuth();
						});
					} else {
						box.innerHTML = `
							<button id="login-google" class="rounded border border-dashed border-zinc-500/40 px-2 py-1 hover:border-link/70 hover:text-global-text">google</button>
							<button id="login-github" class="rounded border border-dashed border-zinc-500/40 px-2 py-1 hover:border-link/70 hover:text-global-text">github</button>
						`;
						document.getElementById('login-google')?.addEventListener('click', () =>
							authClient.signIn.social({ provider: 'google', callbackURL: '/' })
						);
						document.getElementById('login-github')?.addEventListener('click', () =>
							authClient.signIn.social({ provider: 'github', callbackURL: '/' })
						);
					}
				} catch {
					// auth endpoint not reachable (e.g. static preview) — stay quiet
					box.innerHTML = '';
				}
			}
			renderAuth();
		</script>

		<script>
			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				localStorage.setItem('theme', next);
			});
		</script>
	</body>
</html>
