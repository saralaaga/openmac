---
import type { App } from '../lib/apps';

interface Props {
  app: App;
}

const { app } = Astro.props;
const brewCmd = app.install.brew ? `brew install --cask ${app.install.brew}` : null;
---

{
  brewCmd || app.install.mas || app.install.testflight || app.install.dmg ? (
    <div class="card-surface p-5">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400">Install</h2>
      <div class="mt-3 space-y-3">
        {brewCmd && (
          <div class="flex items-center justify-between gap-3 rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-3">
            <code class="truncate text-sm text-emerald-300">{brewCmd}</code>
            <button
              class="copy-btn shrink-0 rounded-lg border border-zinc-700 px-2.5 py-1 text-xs text-zinc-300 hover:border-zinc-500 hover:text-white"
              data-copy={brewCmd}
            >
              Copy
            </button>
          </div>
        )}
        {app.install.mas && (
          <a
            href={`https://apps.apple.com/app/id${app.install.mas}`}
            class="block rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-3 text-sm text-zinc-200 hover:border-zinc-500"
            rel="noopener"
          >
            App Store →
          </a>
        )}
        {app.install.testflight && (
          <a
            href={app.install.testflight}
            class="block rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-3 text-sm text-zinc-200 hover:border-zinc-500"
            rel="noopener"
          >
            Join TestFlight →
          </a>
        )}
        {app.install.dmg && (
          <a
            href={app.install.dmg}
            class="block rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-3 text-sm text-zinc-200 hover:border-zinc-500"
            rel="noopener"
          >
            Download DMG →
          </a>
        )}
      </div>
    </div>
  ) : null
}

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.copy-btn');
    if (!btn) return;
    const text = btn.getAttribute('data-copy') ?? '';
    navigator.clipboard.writeText(text).then(() => {
      const original = btn.textContent;
      btn.textContent = 'Copied ✓';
      setTimeout(() => (btn.textContent = original), 1500);
    });
  });
</script>
