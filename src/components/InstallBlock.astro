---
import type { App } from '../lib/apps';
import { t, type Locale } from '../lib/i18n';

interface Props {
	app: App;
	locale?: Locale;
}

const { app, locale = 'en' } = Astro.props;
const T = t(locale);
const brewCmd = app.install.brew ? `brew install --cask ${app.install.brew}` : null;
---

{
	brewCmd || app.install.mas || app.install.testflight || app.install.downloads?.length ? (
		<div class="card-surface p-5">
			<h2 class="text-muted text-xs font-semibold uppercase tracking-widest">{T.install.title}</h2>
			<div class="mt-3 space-y-3">
				{app.install.downloads?.map((d) => (
					<a
						href={d.url}
						class="download-link cactus-link block rounded-lg border border-dashed border-zinc-500/40 px-4 py-3 text-[13px] hover:border-link/70"
						data-os={d.os}
						data-for-you={T.install.forYou}
						rel="noopener"
					>
						{d.label}{d.size ? ` · ${(d.size / 1024 / 1024).toFixed(1)} MB` : ''} ↓
					</a>
				))}
				{brewCmd && (
					<div
						class="flex items-center justify-between gap-3 rounded-lg border border-dashed border-zinc-500/40 px-4 py-3"
						data-mac-only
					>
						<code class="text-accent truncate text-[13px]">{brewCmd}</code>
						<button
							class="copy-btn text-muted shrink-0 rounded border border-dashed border-zinc-500/40 px-2.5 py-1 text-xs hover:border-link/70 hover:text-global-text"
							data-copy={brewCmd}
						data-copied={T.install.copied}
						>
							{T.install.copy}
						</button>
					</div>
				)}
				{app.install.mas && (
					<a
						href={`https://apps.apple.com/app/id${app.install.mas}`}
						class="cactus-link block rounded-lg border border-dashed border-zinc-500/40 px-4 py-3 text-[13px] hover:border-link/70"
						rel="noopener"
					>
						{T.install.appStore}
					</a>
				)}
				{app.install.testflight && (
					<a
						href={app.install.testflight}
						class="cactus-link block rounded-lg border border-dashed border-zinc-500/40 px-4 py-3 text-[13px] hover:border-link/70"
						rel="noopener"
					>
						{T.install.testFlight}
					</a>
				)}
			</div>
		</div>
	) : null
}

<script>
	document.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest('.copy-btn');
		if (!btn) return;
		const text = btn.getAttribute('data-copy') ?? '';
		navigator.clipboard.writeText(text).then(() => {
			const original = btn.textContent;
			btn.textContent = btn.getAttribute('data-copied') ?? 'copied \u2713';
			setTimeout(() => (btn.textContent = original), 1500);
		});
	});

	// surface the visitor's platform download first; hide mac-only rows elsewhere
	const os = /Mac|iPhone|iPad/i.test(navigator.userAgent)
		? 'mac'
		: /Windows/i.test(navigator.userAgent)
			? 'windows'
			: /Linux|X11|CrOS/i.test(navigator.userAgent)
				? 'linux'
				: null;
	if (os) {
		document.querySelectorAll<HTMLAnchorElement>('.download-link').forEach((el) => {
			if (el.dataset.os === os) {
				el.parentElement?.prepend(el);
				el.classList.add('border-accent/60', 'text-accent');
				el.insertAdjacentHTML('beforeend', ` <span class="text-accent">\u00b7 ${el.dataset.forYou ?? 'for your system'}</span>`);
			}
		});
		if (os !== 'mac') {
			document.querySelectorAll('[data-mac-only]').forEach((el) => el.remove());
		}
	}
</script>
