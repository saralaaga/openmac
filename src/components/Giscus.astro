---
/**
 * Giscus comments (phase 1). Replace the data-* attributes after the GitHub
 * repo is public and Discussions are enabled → https://giscus.app
 * Phase 2 plan: self-hosted comments on CF D1 + better-auth (Research doc §13.2).
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section class="card-surface p-5">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400">Comments</h2>
  <div
    class="giscus mt-4"
    data-repo="YOUR_USERNAME/openmac"
    data-repo-id=""
    data-category="Announcements"
    data-category-id=""
    data-mapping="specific"
    data-term={slug}
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="dark_dimmed"
    data-lang="en"
    data-loading="lazy"
  >
    <p class="text-sm text-zinc-500">
      Comments are powered by Giscus and will appear once the GitHub repository is connected.
    </p>
  </div>
</section>

<script
  is:inline
  src="https://giscus.app/client.js"
  data-repo="YOUR_USERNAME/openmac"
  data-repo-id=""
  data-category="Announcements"
  data-category-id=""
  data-mapping="specific"
  data-term={slug}
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="top"
  data-theme="dark_dimmed"
  data-lang="en"
  data-loading="lazy"
  crossorigin="anonymous"
  async
></script>
