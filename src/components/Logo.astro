---
interface Props {
	size?: number;
}

const { size = 18 } = Astro.props;
---

<svg
	aria-hidden="true"
	width={size}
	height={size}
	viewBox="0 0 16 16"
	shape-rendering="crispEdges"
	class="inline-block shrink-0 align-middle"
>
	<rect width="16" height="16" rx="3" fill="var(--color-global-bg)"></rect>
	<g fill="#e8e8e8">
		<rect x="1" y="1" width="14" height="1"></rect>
		<rect x="1" y="13" width="14" height="1"></rect>
		<rect x="1" y="1" width="1" height="13"></rect>
		<rect x="14" y="1" width="1" height="13"></rect>
		<rect x="3" y="3" width="10" height="1"></rect>
		<rect x="3" y="10" width="10" height="1"></rect>
		<rect x="3" y="3" width="1" height="8"></rect>
		<rect x="12" y="3" width="1" height="8"></rect>
		<rect x="5" y="11" width="6" height="1"></rect>
	</g>
	<g fill="var(--color-accent, #2ec48f)">
		<rect x="4" y="4" width="2" height="1"></rect>
		<rect x="5" y="5" width="2" height="1"></rect>
		<rect x="4" y="6" width="2" height="1"></rect>
		<rect x="7" y="6" width="3" height="1"></rect>
	</g>
</svg>
