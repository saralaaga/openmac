---
import Badge from './Badge.astro';
import { activityOf, activityLabel, formatStars, type App } from '../lib/apps';

interface Props {
  app: App;
}

const { app } = Astro.props;
const activity = activityOf(app);
const activityTone =
  activity === 'active' ? 'green' : activity === 'stale' ? 'amber' : 'red';
---

<a href={`/apps/${app.slug}/`} class="card-surface group block p-5" data-cats={app.categories.join(',')}>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="font-semibold tracking-tight group-hover:text-white">{app.name}</h3>
      <p class="mt-1 line-clamp-2 text-sm text-zinc-400">{app.tagline}</p>
    </div>
    <div class="shrink-0 text-right">
      <div class="text-sm font-medium text-zinc-200">⭐ {formatStars(app.meta.stars)}</div>
      <div class="mt-0.5 text-[11px] text-zinc-500">{app.license}</div>
    </div>
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-1.5">
    <Badge label={activityLabel[activity]} tone={activityTone} />
    {app.platforms.map((p) => <Badge label={p} />)}
  </div>
</a>
