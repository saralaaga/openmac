---
import Badge from './Badge.astro';
import { activityOf, activityLabel, appText, formatStars, type App } from '../lib/apps';
import type { Locale } from '../lib/i18n';

interface Props {
	app: App;
	locale?: Locale;
}

const { app, locale = 'en' } = Astro.props;
const txt = appText(app, locale);
const activity = activityOf(app);
const activityTone =
	activity === 'active' ? 'green' : activity === 'stale' ? 'amber' : 'red';
---

<a href={`/apps/${app.slug}/`} class="card-surface group block p-5" data-cats={app.categories.join(',')}>
	<div class="flex items-start justify-between gap-3">
		<div class="flex min-w-0 items-center gap-3">
			{app.logo && (
				<img
					src={app.logo}
					alt=""
					width="40"
					height="40"
					loading="lazy"
					class="h-10 w-10 shrink-0 rounded-lg border border-dashed border-zinc-500/40"
				/>
			)}
			<div class="min-w-0">
				<h3 class="text-accent-2 font-semibold tracking-tight group-hover:text-link">{app.name}</h3>
				<p class="text-muted mt-1 line-clamp-2">{txt.tagline}</p>
			</div>
		</div>
		<div class="shrink-0 text-right">
			<div class="text-global-text text-sm font-medium">⭐ {formatStars(app.meta.stars)}</div>
			<div class="text-muted mt-0.5 text-[11px]">{app.license}</div>
		</div>
	</div>
	<div class="mt-4 flex flex-wrap items-center gap-1.5">
		<Badge label={activityLabel[activity]} tone={activityTone} />
		{app.platforms.map((p) => <Badge label={p} />)}
	</div>
</a>
