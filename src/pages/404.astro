---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Page not found | OpenMac" description="This page doesn't exist.">
	<section class="py-24 text-center">
		<h1 class="text-accent-2 text-4xl font-bold tracking-tight">404</h1>
		<p class="text-muted mt-3">This page doesn't exist — it may have been removed with our sample content.</p>
		<a href="/" class="cactus-link mt-6 inline-block text-sm">← back to the homepage</a>
	</section>
</Base>
