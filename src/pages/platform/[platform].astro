---
import Base from '../../layouts/Base.astro';
import AppCard from '../../components/AppCard.astro';
import { appsByPlatform, platforms } from '../../lib/apps';

export function getStaticPaths() {
  return platforms.map((p) => ({ params: { platform: p.id }, props: { platform: p } }));
}

const { platform } = Astro.props;
const apps = appsByPlatform(platform.id);
---

<Base
  title={`Open Source Apps for ${platform.name} — OpenMac`}
  description={platform.tagline}
>
  <nav class="text-sm text-zinc-500">
    <a href="/apps" class="hover:text-zinc-300">Apps</a> / <span class="text-zinc-300">{platform.name}</span>
  </nav>
  <h1 class="mt-2 text-3xl font-bold tracking-tight">Open source apps for {platform.name}</h1>
  <p class="mt-3 max-w-2xl text-zinc-400">{platform.tagline}</p>

  <div class="mt-4 flex flex-wrap gap-2">
    {platforms.map((p) => (
      <a
        href={`/platform/${p.id}/`}
        class:list={[
          'rounded-full border px-3 py-1 text-sm',
          p.id === platform.id
            ? 'border-zinc-700 bg-zinc-800 text-white'
            : 'border-zinc-800 text-zinc-400 hover:border-zinc-600',
        ]}
      >
        {p.name}
      </a>
    ))}
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {apps.length > 0 ? apps.map((app) => <AppCard app={app} />) : (
      <p class="text-sm text-zinc-500">Nothing here yet — this platform section is being curated.</p>
    )}
  </div>
</Base>
