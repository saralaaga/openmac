---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import Badge from '../components/Badge.astro';
import { getCollection } from 'astro:content';
import { allApps, categories } from '../lib/apps';

const reviews = (await getCollection('reviews', (r) => !r.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="py-14 text-center">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      Free your Mac.<br /><span class="text-zinc-400">It can do anything.</span>
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-zinc-400">
      A curated, hands-on directory of open source apps for the Apple ecosystem —
      tested by humans, with metadata that never goes stale.
    </p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <a href="/apps" class="rounded-xl bg-white px-5 py-2.5 text-sm font-medium text-zinc-950 hover:bg-zinc-200">
        Browse {allApps.length}+ apps
      </a>
      <a href="/reviews" class="rounded-xl border border-zinc-700 px-5 py-2.5 text-sm text-zinc-200 hover:border-zinc-500">
        Latest reviews
      </a>
    </div>
  </section>

  <section class="py-6">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-semibold tracking-tight">Categories</h2>
      <a href="/apps" class="text-sm text-zinc-400 hover:text-zinc-200">All apps →</a>
    </div>
    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {categories.slice(0, 8).map((c) => (
        <a href={`/apps/category/${c.id}/`} class="card-surface p-4 text-center">
          <span class="text-sm font-medium">{c.name}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="py-6">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-semibold tracking-tight">Most starred</h2>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {allApps.slice(0, 4).map((app) => <AppCard app={app} />)}
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="py-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold tracking-tight">Latest reviews</h2>
        <a href="/reviews" class="text-sm text-zinc-400 hover:text-zinc-200">All reviews →</a>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {reviews.map((r) => (
          <a href={`/reviews/${r.id}/`} class="card-surface block p-5">
            {r.data.score !== undefined && <Badge label={`${r.data.score}/10`} tone="green" />}
            <h3 class="mt-2 font-semibold tracking-tight">{r.data.title}</h3>
            <p class="mt-1 line-clamp-2 text-sm text-zinc-400">{r.data.description}</p>
            <time class="mt-3 block text-xs text-zinc-500" datetime={r.data.pubDate.toISOString()}>
              {r.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
