---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import Badge from '../components/Badge.astro';
import { getCollection } from 'astro:content';
import { allApps, categories } from '../lib/apps';

const reviews = (await getCollection('reviews', (r) => !r.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="py-12 text-center">
    <h1 class="text-accent-2 text-3xl font-bold tracking-tight sm:text-4xl">
      Free your Mac.<br /><span class="text-muted">It can do anything.</span>
    </h1>
    <p class="text-muted mx-auto mt-5 max-w-xl leading-relaxed">
      A curated, hands-on directory of open source apps for the Apple ecosystem —
      tested by humans, with metadata that never goes stale.
    </p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <a href="/apps" class="text-global-bg rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold hover:opacity-85">
        Browse {allApps.length}+ apps
      </a>
      <a href="/reviews" class="cactus-link rounded-lg border border-dashed border-zinc-500/40 px-5 py-2.5 text-sm hover:border-link/70">
        Latest reviews
      </a>
    </div>
  </section>

  <section class="py-6">
    <div class="flex items-center justify-between">
      <h2 class="title">Categories</h2>
      <a href="/apps" class="cactus-link text-muted text-xs">all apps →</a>
    </div>
    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {categories.slice(0, 8).map((c) => (
        <a href={`/apps/category/${c.id}/`} class="card-surface p-3 text-center text-[13px] font-medium">
          {c.name}
        </a>
      ))}
    </div>
  </section>

  <section class="py-6">
    <h2 class="title">Most starred</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {allApps.slice(0, 4).map((app) => <AppCard app={app} />)}
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="py-6">
      <div class="flex items-center justify-between">
        <h2 class="title">Latest reviews</h2>
        <a href="/reviews" class="cactus-link text-muted text-xs">all reviews →</a>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {reviews.map((r) => (
          <a href={`/reviews/${r.id}/`} class="card-surface block p-5">
            {r.data.score !== undefined && <Badge label={`${r.data.score}/10`} tone="green" />}
            <h3 class="text-accent-2 mt-2 font-semibold tracking-tight">{r.data.title}</h3>
            <p class="text-muted mt-1 line-clamp-2">{r.data.description}</p>
            <time class="text-muted mt-3 block text-xs" datetime={r.data.pubDate.toISOString()}>
              {r.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
