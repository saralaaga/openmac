---
import Base from '../../layouts/Base.astro';
import AppCard from '../../components/AppCard.astro';
import { allApps, categories } from '../../lib/apps';
---

<Base title="Apps — OpenMac" description="Browse the curated open source app directory for the Apple ecosystem.">
  <h1 class="title">Apps</h1>
  <p class="text-muted mt-2">{allApps.length} curated open source apps and counting.</p>

  <div id="filters" class="mt-6 flex flex-wrap gap-2">
    <button class="filter-chip rounded-full border border-dashed border-zinc-500/40 px-3 py-1 text-xs" data-cat="all">
      all
    </button>
    {categories.map((c) => (
      <button class="filter-chip rounded-full border border-dashed border-zinc-500/40 px-3 py-1 text-xs" data-cat={c.id}>
        {c.name}
      </button>
    ))}
  </div>

  <div id="grid" class="mt-8 grid gap-4 sm:grid-cols-2">
    {allApps.map((app) => <AppCard app={app} />)}
  </div>
</Base>

<script>
  const chips = document.querySelectorAll('.filter-chip');
  const cards = document.querySelectorAll('#grid > a');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const cat = chip.getAttribute('data-cat');
      chips.forEach((c) => {
        c.classList.remove('text-accent', 'border-accent/60');
      });
      chip.classList.add('text-accent', 'border-accent/60');
      cards.forEach((card) => {
        const cats = (card.getAttribute('data-cats') ?? '').split(',');
        card.classList.toggle('hidden', cat !== 'all' && !cats.includes(cat ?? ''));
      });
    });
  });
</script>
