---
import Base from '../../../layouts/Base.astro';
import AppCard from '../../../components/AppCard.astro';
import { appsByCategory, categories } from '../../../lib/apps';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.id }, props: { category: c } }));
}

const { category } = Astro.props;
const apps = appsByCategory(category.id);
---

<Base
  title={`Open Source ${category.name} Apps — OpenMac`}
  description={category.description}
>
  <nav class="text-sm text-zinc-500">
    <a href="/apps" class="hover:text-zinc-300">Apps</a> / <span class="text-zinc-300">{category.name}</span>
  </nav>
  <h1 class="mt-2 text-3xl font-bold tracking-tight">Open source {category.name.toLowerCase()} apps</h1>
  <p class="mt-3 max-w-2xl text-zinc-400">{category.description}</p>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {apps.length > 0 ? apps.map((app) => <AppCard app={app} />) : (
      <p class="text-sm text-zinc-500">Nothing here yet — this category is being curated.</p>
    )}
  </div>
</Base>
